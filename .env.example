# Copie para .env e preencha com suas credenciais.

# Canvas: token de acesso pessoal (Conta > Configurações > Novo token de acesso).
CANVAS_API_KEY=seu_token_aqui

# Canvas: URL base da instituição. Padrão: https://canvas.instructure.com
CANVAS_API_URL=https://canvas.instructure.com

# Groq: chave de API usada pelo Agente Tutor (https://console.groq.com/keys).
GROQ_API_KEY=sua_chave_groq_aqui
